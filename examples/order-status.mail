schema OrderStatusRequest {
  order_id: String
}

schema OrderStatusResponse {
  order_id: String
  status: String
  found: Bool
}

tool GetOrderStatus {
  input {
    order_id: String
  }
  output {
    order_id: String
    status: String
    found: Bool
  }
}

provider Sim { type simulated }

agent StatusAgent {
  provider Sim
  model "gpt-4"
  output OrderStatusResponse
  tools {
    allow GetOrderStatus
  }
}

workflow OrderStatusFlow {
  input OrderStatusRequest
  output OrderStatusResponse

  step check_status {
    agent StatusAgent
    context { input }
    save as result
  }

  finish with result
}
